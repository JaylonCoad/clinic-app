<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.ClinicApp.Views.AddPatient"
             NavigatedTo="ContentPage_NavigatedTo"
             Title="AddPatient">
    <VerticalStackLayout>
        <Label 
            Text="Add Patient"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label Text="Enter Name:" FontFamily="OpenSansSemibold"/>
        <Entry Text="{Binding Name}"/>
        <Label Text="Enter Race:" FontFamily="OpenSansSemibold"/>
        <Entry Text="{Binding Race}"/>
        <Label Text="Enter Gender:" FontFamily="OpenSansSemibold"/>
        <Entry Text="{Binding Gender}"/>
        <Label Text="Enter Address:" FontFamily="OpenSansSemibold"/>
        <Entry Text="{Binding Address}"/>
        <Label Text="Enter Birthday:" FontFamily="OpenSansSemibold"/>
        <DatePicker Date="{Binding Birthday}"/>
        <Button Text="Add" Clicked="AddClicked" FontFamily="OpenSansSemibold" />
        <Button Text="Back" Clicked="BackToPatientPage" FontFamily="OpenSansSemibold" />
    </VerticalStackLayout>
</ContentPage>