<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.ClinicApp.Views.PhysicianPage"
             NavigatedTo="ContentPage_NavigatedTo"
             Title="PhysicianPage">
    <VerticalStackLayout>
        <Label 
            Text="Physician Page"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <ListView ItemsSource="{Binding Physicians}" SelectedItem="{Binding SelectedPhysician}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Label Text="{Binding Model.Display}" Grid.Column="0"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Text="Edit" Grid.Column="0" Command="{Binding EditCommand}" CommandParameter="{Binding}" FontFamily="OpenSansSemibold"/>
                                <Button Text="Delete" Grid.Column="1" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" Clicked="RefreshClicked" FontFamily="OpenSansSemibold"/>
                            </Grid>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Add Physician" Clicked="AddPhysician" FontFamily="OpenSansSemibold"/>
        <Button Text="Edit Physician" Clicked="EditPhysician" FontFamily="OpenSansSemibold"/>
        <Button Text="Delete Physician" Clicked="DeletePhysician" FontFamily="OpenSansSemibold"/>
        <Button Text="Create Appointment" Clicked="GoToCreateAppointment" FontFamily="OpenSansSemibold"/>
        <Button Text="Sort by Graduation Date (Ascending)" Clicked="SortByGraduationAscending" FontFamily="OpenSansSemibold"/>
        <Button Text="Sort by Graduation Date (Descending)" Clicked="SortByGraduationDescending" FontFamily="OpenSansSemibold"/>
        <Button Text="Back" Clicked="BackToHome" FontFamily="OpenSansSemibold"/>
    </VerticalStackLayout>
</ContentPage>